# Secrets and local environment files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
coverage/
.nyc_output/

# Flutter / Dart
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/.metadata
frontend/ios/Flutter/ephemeral/
frontend/macos/Flutter/ephemeral/
frontend/windows/flutter/ephemeral/
frontend/linux/flutter/ephemeral/
frontend/.pub-cache/
frontend/.pub/

# Test and build artifacts
*.tsbuildinfo
*.log
build/
dist/

# Prebuilt Flutter Web bundle — intentionally committed for the single
# Docker image deployment (Option A, see docs/DEPLOY_RENDER.md). Everything
# else under frontend/build stays ignored.
!frontend/build/
frontend/build/*
!frontend/build/web/

# Editors and operating systems
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Local database dumps and temporary files
*.sql.gz
*.dump
tmp/
