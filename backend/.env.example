# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string.
# Render: use the Internal Database URL when the API runs in the same region;
# use the External Database URL only from your machine or another network.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# TLS mode: disable | require | no-verify
# - require: encrypt and verify the server certificate (external Render URL).
# - disable: private/internal Render URL or local PostgreSQL without TLS.
# - no-verify: encrypt but skip certificate verification. Use only when the
#   provider does not expose a verifiable certificate chain, and document it.
# Leave empty/omit to resolve automatically from the URL and host.
DATABASE_SSL=require

# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:3000
# Render sets RENDER_EXTERNAL_URL automatically for a deployed service; the API
# also accepts it as a same-origin CORS allowlist entry.

# Request body limit for JSON payloads (Express syntax).
JSON_BODY_LIMIT=100kb

# Maximum PostgreSQL pool clients.
DB_POOL_MAX=10

# Set to false to disable HTTP request logs (tests already disable them).
REQUEST_LOGGING=true

# Seed guard: production seeding requires ALLOW_PROD_SEED=true.
ALLOW_PROD_SEED=false
